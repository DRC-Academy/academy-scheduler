# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del proyecto
#
# Copiá este archivo a `.env.local` y rellenalo con los valores de verdad.
# `.env.local` NO se sube a git. En producción, las mismas variables se cargan en
# Vercel (Project → Settings → Environment Variables).
#
# REGLA: `NEXT_PUBLIC_*` viaja al navegador y es PÚBLICA. Todo lo demás vive solo
# en el servidor. Nunca le pongas el prefijo a un secreto.
#
# Acá solo hay nombres, comentarios y valores de EJEMPLO. Ningún valor real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase) ─────────────────────────────────────────────────

# URL del proyecto. Pública.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave anónima. Pública: viaja en el bundle. Es la que usa el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de SERVICE ROLE. SECRETA, solo servidor: salta las políticas de acceso.
# La usa /progreso-cuenta para buscar al alumno por email sin que el navegador
# reciba ninguna clave (ver lib/supabaseAdmin.ts). Sin ella, esa ruta se cierra y
# el alumno ve "este enlace ha caducado".
# Está en Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Ficha de progreso dentro de "Mi cuenta" de WooCommerce ───────────────────

# Secreto compartido con WordPress para firmar el enlace de /progreso-cuenta.
# El MISMO valor tiene que estar acá (o en Vercel) y en wp-config.php como
# define('DRC_PROGRESO_SECRET', '...'). Si no coincide, el alumno solo ve
# "este enlace ha caducado".
#
# Generalo con 32 bytes aleatorios en hexadecimal:
#     openssl rand -hex 32
#
# El valor de abajo es el de EJEMPLO que usan los tests y el documento
# docs/progreso-wordpress.md. NO lo uses en producción.
PROGRESO_SECRET=ejemplo_no_usar_en_produccion_0123456789abcdef0123456789abcdef

# A dónde lleva el botón "Amplía tu plan" de la ficha. Pública.
NEXT_PUBLIC_UPSELL_URL=https://drcacademy.com/mi-cuenta

# URL pública de la app. De acá sale TODO enlace que se le manda al alumno
# (ver lib/appUrl.ts): nunca del origin de la request, que en Vercel es la URL de
# deployment y rompía los enlaces.
NEXT_PUBLIC_APP_URL=https://academy-scheduler-aqpt.vercel.app

# ── Inteligencia artificial (Anthropic) ──────────────────────────────────────

# Análisis de transcripciones, fichas de alumno, prueba de nivel y avisos de
# riesgo. Sin ella, todo eso queda desactivado (la app sigue funcionando).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar. Sin definir, el que traiga el código por defecto.
ANTHROPIC_MODEL=

# ── Correo (Resend) ──────────────────────────────────────────────────────────

# Avisos por email: bajas, bienvenida, recordatorios de formulario, alertas.
RESEND_API_KEY=re_...

# A dónde contesta el alumno si responde a un email automático.
STUDENT_REPLY_TO_EMAIL=info@drcacademy.com

# Destinatarios de los avisos internos.
ADMIN_NOTIFICATION_EMAIL=
ENDING_PLANS_NOTIFICATION_EMAIL=

# ── WooCommerce (suscripciones) ──────────────────────────────────────────────

# Comprueban si el alumno tiene la suscripción activa. OJO: sin estas, todo lo que
# dependa de WooCommerce solo se puede probar contra el deploy, no en local.
WOOCOMMERCE_URL=https://drcacademy.com
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...

# Valida los webhooks de baja de suscripción que manda WooCommerce.
WOOCOMMERCE_WEBHOOK_SECRET=

# ── Endpoints externos y crons ───────────────────────────────────────────────

# Secreto del endpoint read-only que consume drc-financial-dashboard.
# Se envía en la cabecera X-Dashboard-Secret. Ver lib/externalAuth.ts
DASHBOARD_EXTERNAL_SECRET=pon_aqui_un_secreto_largo

# Protege las rutas /api/cron/*. Vercel lo envía como Bearer al ejecutar los
# crons de vercel.json.
CRON_SECRET=pon_aqui_otro_secreto_largo

# URL del Zap que recibe los planes que terminan. Vacía = no se envía nada.
ZAPIER_ENDING_PLAN_WEBHOOK_URL=
